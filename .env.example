# Select mock (safe default) or real. Never commit your real .env.
INTEGRATION_MODE=mock
DRY_RUN=true

# Okta (real mode)
OKTA_ORG_URL=https://your-org.okta.com
OKTA_API_TOKEN=
OKTA_GROUP_NAME=engineering

# Google Workspace (real mode; domain-wide delegation required)
GOOGLE_SERVICE_ACCOUNT_FILE=/secure/path/service-account.json
GOOGLE_ADMIN_EMAIL=admin@example.com
GOOGLE_DOMAIN=example.com
GOOGLE_ORG_UNIT_PATH=/

# 1Password mock mode is the default. A real group/vault membership
# adapter requires a supported SCIM Bridge/admin configuration.
ONEPASSWORD_MODE=mock
ONEPASSWORD_SCIM_URL=
ONEPASSWORD_SCIM_BEARER_TOKEN=
ONEPASSWORD_NEW_HIRE_GROUP=engineering
ONEPASSWORD_SHARED_VAULT_IDS=

# MDM is intentionally mocked (Jamf/Intune enrollment invite payload).
MDM_PROVIDER=jamf

# Slack offboarding notification (optional; real webhook in either mode)
SLACK_WEBHOOK_URL=

# Logging
LOG_LEVEL=INFO
